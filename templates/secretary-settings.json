{
  "permissions": {
    "deny": [
      "Edit(./AGENTS.md)",
      "Write(./AGENTS.md)",
      "Edit(./CLAUDE.md)",
      "Write(./CLAUDE.md)"
    ]
  },
  "hooks": {
    "UserPromptSubmit": [
      { "hooks": [ { "type": "command", "command": "sh \"${PADDOCK_BIN_DIR:-${XDG_DATA_HOME:-$HOME/.local/share}/paddock/bin}/premise-reminder.sh\"" } ] }
    ],
    "PreToolUse": [
      { "matcher": "^Bash$", "hooks": [ { "type": "command", "command": "sh \"${PADDOCK_BIN_DIR:-${XDG_DATA_HOME:-$HOME/.local/share}/paddock/bin}/secretary-bash-guard.sh\"" } ] }
    ]
  }
}
