{
  "permissions": {
    "allow": [],
    "deny": [
      "Bash(git push:*)",
      "Bash(hc:*)",
      "Bash(gh pr:*)",
      "Bash(gh issue:*)",
      "Bash(gh release:*)",
      "Bash(gh workflow:*)",
      "Bash(gh api:*)",
      "Read(~/.config/gh/hosts.yml)",
      "Read(~/.config/herdr-core/**)",
      "Read(~/.config/herdr-app/**)",
      "Read(~/.local/state/herdr-core/**)",
      "Edit(~/.config/herdr-core/**)",
      "Edit(~/.config/herdr-app/**)",
      "Edit(~/.local/state/herdr-core/**)",
      "Edit(~/.local/share/paddock/**)",
      "Edit(~/.local/state/paddock/**)",
      "Edit(~/.claude/settings.json)",
      "Edit(.claude/settings*.json)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash|Skill|.*[Cc]odex.*",
        "hooks": [
          {
            "type": "command",
            "command": "if [ -n \"${PADDOCK_ORG:-}\" ]; then bash \"$PADDOCK_ORG\" --as codex-gate codex_round hook || exit 2; elif grep -qi codex; then echo 'org: refused: PADDOCK_ORG is not set, so a call naming codex cannot be counted' >&2; exit 2; fi"
          }
        ]
      }
    ]
  },
  "sandbox": {
    "enabled": true,
    "failIfUnavailable": true,
    "allowUnsandboxedCommands": false,
    "excludedCommands": [],
    "filesystem": {
      "allowWrite": [],
      "denyRead": [
        "~/.config/gh/hosts.yml",
        "~/.local/state/herdr-core",
        "~/.config/herdr-app"
      ],
      "denyWrite": [
        "~/.config/herdr-core",
        "~/.config/herdr-app",
        "~/.local/state/herdr-core",
        "~/.local/share/paddock"
      ]
    }
  }
}
