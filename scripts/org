#!/usr/bin/env bash
# org: the organization's mailbox and run records as shell commands (Issue #60, Q8 (b),
# decisions 0002 and 0004). Needs only bash, coreutils, sed and awk; `hc` only for `doc`.
# No resident process: every call reads and appends files, so it works with no window open.
set -u
export LC_ALL=C

usage() {
  cat <<'USAGE'
Usage: org [--as <id>] <command> [args]

  send_message <to> <text>                      put a message in <to>'s box
  check_messages [--peek]                       print unread messages for you, mark them read
  set_summary <text>                            say what you are doing (shown by list_runs)
  report <start|done|blocked> --task <task_id> [--to <id>] <text>
                                                write a run record and tell <to> (default: secretary)
  ci_completed --pr N --sha SHA --run-id N --exit-code N [--task ID]
                                                record a watched CI run (org-pull-request writes
                                                it as secretary; conclusion from the exit code)
  list_runs                                     latest state per task, and each agent's summary
  wait [--timeout S] [--children]               hold until you have unread mail (prints
                                                {"reason":"mail","unread":N}; marks nothing read)
                                                or S seconds pass ({"reason":"timeout"}; default
                                                $PADDOCK_WAIT_TIMEOUT, else 60); --children also
                                                ends on hc wait --children any's children line
                                                Every return also checks each org-state.work task
                                                against the core and adds "gone" (no terminal or it
                                                ended, no done record), "waiting" (blocked),
                                                "unreported" (done in the core, no done record),
                                                "unreadable" or "watch_error"; nothing when quiet
  brief                                         read-only: print secretary-handover, org-state and
                                                each terminal labelled task_id with its status
  doc get <name>                                print a core document's value
  doc set <name>                                set it from stdin (secretary only)
  doc update <name> -- <command...>             re-read, run command (old value on stdin, new
                                                value on stdout), set; on a version conflict
                                                re-read and reapply (secretary only)

Your id comes from --as or $PADDOCK_ORG_ID (lowercase letters, digits, _ and -).
History is JSON lines, events/<YYYY-MM>/<id>.jsonl under $PADDOCK_STATE_DIR
(default ${XDG_STATE_HOME:-~/.local/state}/paddock); each id appends only to its own file.
Readers look at this month and the last. $PADDOCK_NOW (UTC ISO 8601) fixes the clock for tests.
Documents are the names of decision 0004: org-state (64 KiB), secretary-handover (32 KiB; null, or
an object with exactly last_exchange, unrecorded_decisions, open_threads and a UTC written_at; needs jq);
the writer is secretary (or the terminal name in $PADDOCK_SECRETARY_NAME, for a probe beside a real one). $PADDOCK_HC_HOLD seconds (default 1)
is how long hc connect's input stays open after a request. $PADDOCK_WAIT_POLL seconds (default 2)
is how often wait looks at the mailbox. $PADDOCK_LOCK_WAIT seconds (default 60) is how long a
write waits for its id's lock when the holder is alive or unknown (a dead holder's lock is broken).

Exit codes: 0 ok, 2 bad usage, 3 hc not found (doc), 5 store or core error, 6 document name
not allowed, 7 not the document's writer, 8 value over the cap, 9 version conflict that did
not clear after 5 tries, 10 the update command failed.
USAGE
}

die() { code=$1; shift; echo "org: $*" >&2; exit "$code"; }
tab=$(printf '\t'); cr=$(printf '\r')

id=${PADDOCK_ORG_ID:-}
case "${1:-}" in -h|--help|help) usage; exit 0 ;; esac
if [ "${1:-}" = --as ]; then [ $# -ge 2 ] || die 2 "--as needs an id"; id=$2; shift 2; fi
cmd=${1:-}; [ $# -eq 0 ] || shift
[ -n "$cmd" ] || { usage >&2; exit 2; }

valid_id() { case "$1" in ''|-*|*[!a-z0-9_-]*) return 1 ;; esac; }
case "$cmd" in
  send_message|check_messages|set_summary|report|ci_completed|list_runs|doc|wait|brief) ;;
  *) echo "org: unknown command: $cmd" >&2; usage >&2; exit 2 ;;
esac
valid_id "$id" || die 2 "no valid id: give --as <id> or set PADDOCK_ORG_ID (lowercase letters, digits, _ and -)"

state=${PADDOCK_STATE_DIR:-${XDG_STATE_HOME:-$HOME/.local/state}/paddock}
# clock: sets now, cur (this month) and prev (the last). wait calls it on every poll.
clock() {
  local y m
  now=${PADDOCK_NOW:-$(date -u +%Y-%m-%dT%H:%M:%SZ)}
  cur=${now:0:7}
  y=${cur%-*}; m=$((10#${cur#*-} - 1)); [ "$m" -gt 0 ] || { m=12; y=$((10#$y - 1)); }
  prev=$(printf '%04d-%02d' "$((10#$y))" "$m")
}
clock

# json_esc: stdin -> a JSON string body (no quotes). Control characters other than newline
# and tab are dropped; newline becomes \n, tab \t.
json_esc() {
  tr -d '\000-\010\013\014\016-\037' \
    | sed -e 's/\\/\\\\/g' -e 's/"/\\"/g' -e "s/$tab/\\\\t/g" -e "s/$cr/\\\\r/g" \
    | awk 'NR>1{printf "%s","\\n"} {printf "%s",$0}'
}

# next_seq: one more than the highest seq on any line of this id's files (continues across
# months; a writer that took its month before the lock may write to an older file). Every line,
# not only the last: a ci_completed line from before Issue #168 can end a file with a lower seq.
# ponytail: reads all of the id's history per write; keep a high-water file if it grows large.
next_seq() {
  cat "$state"/events/*/"$id".jsonl 2>/dev/null \
    | awk 'match($0, /^\{"seq":[0-9]+,/) { s = substr($0, 8, RLENGTH - 8) + 0; if (s > m) m = s } END { print m + 1 }'
}

# excl <file> <text>: create <file> holding <text> only if it does not exist yet. The shell's own
# noclobber open (O_EXCL) decides, so no external command's exit status is trusted for it.
excl() { local r; set -C; { printf '%s\n' "$2" > "$1"; } 2>/dev/null; r=$?; set +C; return "$r"; }

# append <kind> <to> <task_id> <text>: one message-shaped line in this id's own file.
append() {
  local body
  body=$(printf '%s\n' "$4" | json_esc)
  [ "${#body}" -le 32768 ] || die 2 "text is longer than 32 KiB"
  put "\"ts\":\"$now\",\"from\":\"$id\",\"kind\":\"$1\",\"to\":\"$2\",\"task_id\":\"$3\",\"text\":\"$body\""
}

# put <fields>: the line {"seq":<next>,<fields>} in this id's own file. A lock per id keeps seq
# unique and increasing when one agent runs commands in parallel (Issue #145). The lock is the
# folder <lock> holding the file <lock>/pid: a writer holds it only when its mkdir succeeded AND
# it created <lock>/pid itself with excl. mkdir alone is not trusted: uutils coreutils 0.10.0
# mkdir (a GitHub ubuntu runner, 2026-11) reported success to the loser of a race for the same
# folder; GNU coreutils 9.4 mkdir was not seen to do so. A waiter never breaks a lock
# whose holder is alive: it breaks one only when the recorded pid is dead, holding the guard
# file <lock>.break, and only if the pid it re-reads there is still that dead one. A lock with no
# pid recorded (holder killed right after mkdir) or a .break left behind is never broken: the
# send gives up after $PADDOCK_LOCK_WAIT s (default 60) with exit 5 and names what to remove.
put() {
  local d=$state/events/$cur lk=$state/events/$id.lock me=${BASHPID:-$$} n=0 o ok=0 end
  mkdir -p "$d" || die 5 "cannot create $d"
  end=$((SECONDS + ${PADDOCK_LOCK_WAIT:-60}))
  until mkdir "$lk" 2>/dev/null && excl "$lk/pid" "$me"; do
    n=$((n + 1))
    if [ $((n % 20)) -eq 0 ]; then
      o=$(cat "$lk/pid" 2>/dev/null)
      case "$o" in ''|*[!0-9]*) ;; *)
        if ! kill -0 "$o" 2>/dev/null && excl "$lk.break" "$me"; then
          [ "$(cat "$lk/pid" 2>/dev/null)" = "$o" ] && ! kill -0 "$o" 2>/dev/null \
            && rm -f "$lk/pid" && rmdir "$lk" 2>/dev/null
          rm -f "$lk.break"
        fi ;;
      esac
      [ "$SECONDS" -lt "$end" ] || die 5 "lock $lk is held (pid ${o:-not recorded}); if no org command of $id is running, remove $lk and $lk.break"
    fi
    sleep 0.05 2>/dev/null || sleep 1
  done
  printf '{"seq":%s,%s}\n' "$(next_seq)" "$1" >> "$d/$id.jsonl" && ok=1
  rm -f "$lk/pid"; rmdir "$lk" 2>/dev/null
  [ "$ok" -eq 1 ] || die 5 "cannot write $d/$id.jsonl"
}

# window: every line of this month's and the previous month's files as TSV
# seq ts from kind to task_id text (text still JSON-escaped; it has no raw tab or newline).
window() {
  local f
  for f in "$state/events/$prev"/*.jsonl "$state/events/$cur"/*.jsonl; do
    [ -f "$f" ] && cat "$f"
  done | sed -n "s/^{\"seq\":\([0-9]*\),\"ts\":\"\([^\"]*\)\",\"from\":\"\([^\"]*\)\",\"kind\":\"\([^\"]*\)\",\"to\":\"\([^\"]*\)\",\"task_id\":\"\([^\"]*\)\",\"text\":\"\(.*\)\"}\$/\1$tab\2$tab\3$tab\4$tab\5$tab\6$tab\7/p"
}

# unread_lines: the window's lines addressed to $id above its last ack per sender (unsorted).
unread_lines() {
  window | awk -F"$tab" -v me="$id" '
    $3==me && $4=="ack" { split($7,a," "); if (a[2]+0>acked[a[1]]) acked[a[1]]=a[2]+0; next }
    $5==me { n++; seq[n]=$1; line[n]=$0 }
    END { for (i=1;i<=n;i++) { split(line[i],f,"\t"); if (seq[i]+0>acked[f[3]]+0) print line[i] } }'
}

# AWK_UNESC: undo json_esc.
AWK_UNESC='function unesc(s,  o,i,c,n){o="";for(i=1;i<=length(s);i++){c=substr(s,i,1);if(c=="\\"){i++;n=substr(s,i,1);o=o (n=="n"?"\n":n=="t"?"\t":n=="r"?"\r":n)}else o=o c}return o}'

case "$cmd" in
  send_message)
    [ $# -ge 2 ] || die 2 "usage: send_message <to> <text>"
    to=$1; shift; text="$*"
    valid_id "$to" || die 2 "invalid recipient: $to"
    [ -n "$text" ] || die 2 "empty text"
    append message "$to" "" "$text" ;;

  set_summary)
    [ $# -ge 1 ] && [ -n "$*" ] || die 2 "usage: set_summary <text>"
    append summary "" "" "$*" ;;

  report)
    status=${1:-}; [ $# -eq 0 ] || shift
    case "$status" in start) kind=run_started ;; done) kind=run_completed ;; blocked) kind=run_blocked ;;
      *) die 2 "usage: report <start|done|blocked> --task <task_id> [--to <id>] <text>" ;; esac
    task=; to=secretary
    while [ $# -gt 0 ]; do
      case "$1" in
        --task) [ $# -ge 2 ] || die 2 "--task needs a value"; task=$2; shift 2 ;;
        --to) [ $# -ge 2 ] || die 2 "--to needs a value"; to=$2; shift 2 ;;
        --) shift; break ;;
        *) break ;;
      esac
    done
    valid_id "$task" || die 2 "report needs --task <task_id> (lowercase letters, digits, _ and -)"
    valid_id "$to" || die 2 "invalid recipient: $to"
    [ -n "$*" ] || die 2 "report needs text"
    append "$kind" "$to" "$task" "$*" ;;

  ci_completed)
    # Issue #168: org-pull-request records the watched CI run here, so it shares this id's
    # folder, seq and lock. Fields as before (SKILL.md of org-pull-request, decision 0004).
    pr=; sha=; run=; code=; task=
    while [ $# -gt 0 ]; do
      case "$1" in
        --pr|--sha|--run-id|--exit-code|--task)
          [ $# -ge 2 ] || die 2 "$1 needs a value"
          case "$1" in --pr) pr=$2 ;; --sha) sha=$2 ;; --run-id) run=$2 ;; --exit-code) code=$2 ;; --task) task=$2 ;; esac
          shift 2 ;;
        *) die 2 "usage: ci_completed --pr N --sha SHA --run-id N --exit-code N [--task ID]" ;;
      esac
    done
    num() { case "$1" in 0) ;; [1-9]*) case "$1" in *[!0-9]*) return 1 ;; esac ;; *) return 1 ;; esac; }
    num "$pr" && num "$run" && num "$code" || die 2 "--pr, --run-id and --exit-code need whole numbers (no leading zero)"
    case "$sha" in ''|*[!0-9a-f]*) die 2 "--sha needs a hex commit id" ;; esac
    case "$task" in *[!A-Za-z0-9._-]*) die 2 "--task may hold only letters, digits, . _ -" ;; esac
    [ "$code" = 0 ] && concl=success || concl=failure
    tj=; [ -z "$task" ] || tj=",\"task_id\":\"$task\""
    put "\"ts\":\"$now\",\"kind\":\"ci_completed\",\"writer\":\"$id\"$tj,\"pr\":$pr,\"sha\":\"$sha\",\"run_id\":$run,\"exit_code\":$code,\"conclusion\":\"$concl\"" ;;

  check_messages)
    peek=
    case "${1:-}" in --peek) peek=1 ;; "") ;; *) die 2 "usage: check_messages [--peek]" ;; esac
    unread=$(unread_lines | sort -s -t "$tab" -k2,2 -k3,3 -k1,1n)
    if [ -z "$unread" ]; then echo "no new messages"; exit 0; fi
    printf '%s\n' "$unread" | awk -F"$tab" "$AWK_UNESC"'
      { printf "[%s#%s %s %s%s]\n%s\n\n", $3, $1, $2, $4, ($6==""?"":" task=" $6), unesc($7) }'
    if [ -z "$peek" ]; then
      # the loop runs in this shell, not a pipeline subshell, so append's lock owner is this process
      while read -r s u; do append ack "" "" "$s $u"; done < <(printf '%s\n' "$unread" \
        | awk -F"$tab" '{ if ($1+0>m[$3]+0) m[$3]=$1+0 } END { for (s in m) print s, m[s] }' | sort)
    fi ;;

  wait)
    # Issue #140: the secretary ends its turns here while work or approvals are in progress,
    # so a mailbox message (the card's ANSWER, a worker's report) starts its next turn.
    # ponytail: polls the files every PADDOCK_WAIT_POLL s; a file-change wait if they grow large.
    timeout=${PADDOCK_WAIT_TIMEOUT:-60}; children=
    while [ $# -gt 0 ]; do
      case "$1" in
        --timeout) [ $# -ge 2 ] || die 2 "--timeout needs a value"; timeout=$2; shift 2 ;;
        --children) children=1; shift ;;
        *) die 2 "usage: wait [--timeout S] [--children]" ;;
      esac
    done
    case "$timeout" in ''|*[!0-9]*|0) die 2 "--timeout needs a whole number of seconds above 0" ;; esac
    poll=${PADDOCK_WAIT_POLL:-2}
    hout=; hpid=
    if [ -n "$children" ] && command -v hc >/dev/null 2>&1; then
      hout=$(mktemp) || die 5 "cannot create a temp file"
      hc wait --children any --timeout "$timeout" > "$hout" 2>&1 & hpid=$!
    fi
    finish() { [ -z "$hpid" ] || kill "$hpid" 2>/dev/null; [ -z "$hout" ] || rm -f "$hout"; }
    trap finish EXIT
    # Issue #175: on every return, each task in org-state.work is checked against the core.
    # watch prints extra JSON members: "gone" (no terminal or it ended, and no done record),
    # "waiting" (status blocked), "unreported" (status done, no done record), "unreadable"
    # (hc get failed some other way), or "watch_error" (org-state not readable). Nothing when quiet.
    # ponytail: done records are looked for in this and the last month.
    watch() {
      local doc ids t j st fin g= w= u= x= runs
      doc=$(bash "$0" --as "$id" doc get org-state 2>&1) || {
        printf ',"watch_error":"%s"' "$(printf '%s' "${doc:0:120}" | json_esc)"; return; }
      # The work array is cut out with a scan that skips string contents, so a "]" in a title
      # does not end it.
      ids=$(printf '%s' "$doc" | tr -d '\n' | awk '{
          if (!match($0, /"work": *\[/)) exit
          s = substr($0, RSTART + RLENGTH); d = 1; q = 0; o = ""
          for (i = 1; i <= length(s); i++) { c = substr(s, i, 1)
            if (q) { if (c == "\\") { o = o c substr(s, ++i, 1); continue } if (c == "\"") q = 0 }
            else if (c == "\"") q = 1; else if (c == "[") d++; else if (c == "]" && --d == 0) break
            o = o c }
          print o }' | grep -o '"task_id": *"[^"]*"' | sed 's/.*: *"//; s/"$//')
      # Done as org-close counts it: from w-<task> to secretary, at or after the task's latest start.
      runs=$(window | awk -F"$tab" '$4=="run_started" && $3=="secretary" { if ($2 > st[$6]) st[$6] = $2 }
        $4=="run_completed" && $3=="w-" $6 && $5=="secretary" { if ($2 > dn[$6]) dn[$6] = $2 }
        END { for (k in dn) if (dn[k] >= st[k]) print k }')
      for t in $ids; do
        # A done record silences "gone" and "unreported" only; a worker blocked again is still listed.
        fin=; ! printf '%s\n' "$runs" | grep -qxF "$t" || fin=1
        if ! j=$(hc get --json "w-$t" 2>&1); then
          case "$j" in *not_found*) [ -n "$fin" ] || g="$g${g:+,}\"$t\"" ;; *) x="$x${x:+,}\"$t\"" ;; esac
          continue
        fi
        j=$(printf '%s' "$j" | tr -d '\n')
        # the status state is one of these words; a message holding braces or a quoted state cannot hide it
        st=$(printf '%s' "$j" | grep -Eo '"state": *"(working|blocked|done|error|idle)"' | head -1 | sed 's/.*: *"//; s/"$//')
        [ -z "$fin" ] || [ "$st" = blocked ] || continue
        case "$st" in
          blocked) w="$w${w:+,}\"$t\"" ;;
          done) u="$u${u:+,}\"$t\"" ;;
          *) printf '%s' "$j" | grep -Eq '"state": *"finished"' && g="$g${g:+,}\"$t\"" ;;
        esac
      done
      [ -z "$g" ] || printf ',"gone":[%s]' "$g"
      [ -z "$w" ] || printf ',"waiting":[%s]' "$w"
      [ -z "$u" ] || printf ',"unreported":[%s]' "$u"
      [ -z "$x" ] || printf ',"unreadable":[%s]' "$x"
    }
    end=$((SECONDS + timeout))
    while :; do
      clock
      n=$(unread_lines | wc -l | tr -d ' ')
      if [ "$n" -gt 0 ]; then printf '{"reason":"mail","unread":%s%s}\n' "$n" "$(watch)"; exit 0; fi
      # hc wait's own line counts only when a child ended; any other ending (no children,
      # needs_target, its own check-in) is dropped and the mail wait goes on.
      if [ -n "$hpid" ] && ! kill -0 "$hpid" 2>/dev/null; then
        if grep -Eq '"reason": *"(children|exit)"' "$hout"; then
          line=$(tr -d '\n' < "$hout"); printf '%s%s}\n' "${line%\}}" "$(watch)"; exit 0
        fi
        hpid=
      fi
      [ "$SECONDS" -lt "$end" ] || { printf '{"reason":"timeout"%s}\n' "$(watch)"; exit 0; }
      sleep "$poll"
    done ;;

  list_runs)
    all=$(window)
    echo "runs (task, writer, state, time, last text)"
    printf '%s\n' "$all" | awk -F"$tab" "$AWK_UNESC"'
      $4=="run_started"||$4=="run_completed"||$4=="run_blocked" {
        k=$6; if (!(k in ts) || $2>ts[k] || ($2==ts[k] && $1+0>=sq[k]+0)) { ts[k]=$2; sq[k]=$1; w[k]=$3; st[k]=$4; tx[k]=$7 } }
      END { for (k in ts) { s=st[k]; sub(/^run_/,"",s); if (s=="completed") s="done"; t=unesc(tx[k]); gsub(/\n/," ",t)
              printf "%s\t%s\t%s\t%s\t%s\n", k, w[k], s, ts[k], substr(t,1,100) } }' | sort -t "$tab" -k4,4 -k1,1
    echo "summaries (agent, time, text)"
    printf '%s\n' "$all" | awk -F"$tab" "$AWK_UNESC"'
      $4=="summary" { k=$3; if (!(k in ts) || $2>ts[k] || ($2==ts[k] && $1+0>=sq[k]+0)) { ts[k]=$2; sq[k]=$1; tx[k]=$7 } }
      END { for (k in ts) { t=unesc(tx[k]); gsub(/\n/," ",t); printf "%s\t%s\t%s\n", k, ts[k], substr(t,1,200) } }' | sort ;;

  brief)
    # Issue #191: what a resuming secretary reads, in one read-only call (hc ls, hc get, doc get).
    [ $# -eq 0 ] || die 2 "usage: brief"
    for d in secretary-handover org-state; do
      echo "== $d"; bash "$0" --as "$id" doc get "$d" || exit $?
    done
    echo "== labelled terminals (name, task_id, status)"
    names=$(hc ls 2>&1) || die 5 "cannot reach the herdr core (hc ls failed)"
    for n in $(printf '%s' "$names" | tr -d '\n' | grep -o '"name": *"[^"]*"' | sed 's/.*: *"//; s/"$//'); do
      if ! j=$(hc get --json "$n" 2>&1); then
        case "$j" in *not_found*) ;; *) printf '%s\t(unreadable)\n' "$n" ;; esac  # not_found: ended since hc ls
        continue
      fi
      j=$(printf '%s' "$j" | tr -d '\n')
      t=$(printf '%s' "$j" | sed -n 's/.*"task_id": *"\([^"]*\)".*/\1/p')
      [ -n "$t" ] || continue
      s=$(printf '%s' "$j" | grep -Eo '"state": *"(working|blocked|done|error|idle)"' | head -1 | sed 's/.*: *"//; s/"$//')
      printf '%s\t%s\t%s\n' "$n" "$t" "${s:-no status}"
    done ;;

  doc)
    sub=${1:-}; [ $# -eq 0 ] || shift
    name=${1:-}; [ $# -eq 0 ] || shift
    case "$name" in
      org-state) cap=65536 ;;
      secretary-handover) cap=32768 ;;
      *) die 6 "document name not allowed: '$name' (decision 0004 lists org-state and secretary-handover)" ;;
    esac
    case "$sub" in
      get) ;;
      set|update)
        # PADDOCK_SECRETARY_NAME is the terminal name (org-start); accept it as well as `secretary`.
        [ "$id" = secretary ] || [ "$id" = "${PADDOCK_SECRETARY_NAME:-secretary}" ] || die 7 "only secretary writes $name"
        if [ "$sub" = update ]; then
          [ "${1:-}" = -- ] && shift
          [ $# -gt 0 ] || die 2 "usage: doc update <name> -- <command...>"
        else
          [ $# -eq 0 ] || die 2 "usage: doc set <name> (value on stdin)"
          stdin_value=$(tr -d '\n')
          [ -n "$stdin_value" ] || die 2 "doc set: empty value on stdin"
        fi ;;
      *) die 2 "usage: doc get|set|update <name>" ;;
    esac
    command -v hc >/dev/null 2>&1 || die 3 "hc not found on PATH (install herdr-core)"

    # One JSON-RPC line through hc connect, input held open (hc can end at end of input
    # before it answers; prototype 1).
    rpc() { { printf '%s\n' "$1"; sleep "${PADDOCK_HC_HOLD:-1}"; } | hc connect 2>/dev/null | tr -d '\n'; }
    # read_doc: sets $val and $ver.
    read_doc() {
      local ans
      ans=$(rpc "{\"jsonrpc\":\"2.0\",\"id\":1,\"method\":\"doc.get\",\"params\":{\"name\":\"$name\"}}")
      case "$ans" in *'"result"'*) ;; *) die 5 "doc.get $name failed: ${ans:0:200}" ;; esac
      # Anchored at both ends so a "version" key inside the value is left alone.
      val=$(printf '%s' "$ans" | sed -e 's/^{[^{]*"result": *{ *"value": *//' -e 's/ *, *"version": *[0-9][0-9]* *} *} *$//')
      ver=$(printf '%s' "$ans" | sed -n 's/.*"version": *\([0-9][0-9]*\) *} *} *$/\1/p')
      [ -n "$val" ] && [ -n "$ver" ] || die 5 "doc.get $name: cannot read value and version from: ${ans:0:200}"
    }

    if [ "$sub" = get ]; then read_doc; printf '%s\n' "$val"; exit 0; fi

    tries=0
    while [ "$tries" -lt 5 ]; do
      tries=$((tries + 1))
      read_doc
      if [ "$sub" = set ]; then new=$stdin_value
      else
        new=$(printf '%s' "$val" | "$@") || die 10 "update command failed; $name not written"
        new=$(printf '%s' "$new" | tr -d '\n')
      fi
      [ -n "$new" ] || die 10 "update command printed no value; $name not written"
      [ "${#new}" -le "$cap" ] || die 8 "value is ${#new} bytes, over the $cap cap of $name"
      if [ "$name" = secretary-handover ]; then
        command -v jq >/dev/null 2>&1 || die 3 "jq not found on PATH (needed to check secretary-handover)"
        printf '%s' "$new" | jq -e '. == null or (type == "object"
            and (keys | sort) == ["last_exchange","open_threads","unrecorded_decisions","written_at"]
            and (.written_at | type == "string" and test("^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]+)?Z$") and (sub("\\.[0-9]+";"") | try (fromdateiso8601 | true) catch false)))' >/dev/null 2>&1 \
          || die 2 "secretary-handover must be null or an object with exactly last_exchange, unrecorded_decisions, open_threads and written_at (UTC ISO 8601, ending in Z); nothing written"
      fi
      ans=$(rpc "{\"jsonrpc\":\"2.0\",\"id\":1,\"method\":\"doc.set\",\"params\":{\"name\":\"$name\",\"value\":$new,\"version\":$ver}}")
      case "$ans" in
        *'"error"'*conflict*) continue ;;
        *'"error"'*) die 5 "doc.set $name failed: ${ans:0:200}" ;;
        *'"result"'*) exit 0 ;;
        *) die 5 "doc.set $name: no answer from hc connect" ;;
      esac
    done
    die 9 "doc.set $name kept conflicting after 5 tries" ;;
esac
