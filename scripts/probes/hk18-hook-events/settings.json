{
  "permissions": { "allow": ["Bash(echo hk18)"] },
  "hooks": {
    "SessionStart": [{ "hooks": [{ "type": "command", "command": "printf '%s %s %s\\n' SessionStart \"$(date +%s)\" \"$(cat | tr -d '\\n' | cut -c1-300)\" >> \"$HK18_MARKERS\"" }] }],
    "UserPromptSubmit": [{ "hooks": [{ "type": "command", "command": "printf '%s %s %s\\n' UserPromptSubmit \"$(date +%s)\" \"$(cat | tr -d '\\n' | cut -c1-300)\" >> \"$HK18_MARKERS\"" }] }],
    "PreToolUse": [{ "matcher": "Bash", "hooks": [{ "type": "command", "command": "printf '%s %s %s\\n' PreToolUse \"$(date +%s)\" \"$(cat | tr -d '\\n' | cut -c1-300)\" >> \"$HK18_MARKERS\"" }] }],
    "PostToolUse": [{ "matcher": "Bash", "hooks": [{ "type": "command", "command": "printf '%s %s %s\\n' PostToolUse \"$(date +%s)\" \"$(cat | tr -d '\\n' | cut -c1-300)\" >> \"$HK18_MARKERS\"" }] }],
    "PreCompact": [{ "hooks": [{ "type": "command", "command": "printf '%s %s %s\\n' PreCompact \"$(date +%s)\" \"$(cat | tr -d '\\n' | cut -c1-300)\" >> \"$HK18_MARKERS\"" }] }],
    "Notification": [{ "hooks": [{ "type": "command", "command": "printf '%s %s %s\\n' Notification \"$(date +%s)\" \"$(cat | tr -d '\\n' | cut -c1-300)\" >> \"$HK18_MARKERS\"" }] }],
    "Stop": [{ "hooks": [{ "type": "command", "command": "printf '%s %s %s\\n' Stop \"$(date +%s)\" \"$(cat | tr -d '\\n' | cut -c1-300)\" >> \"$HK18_MARKERS\"" }] }]
  }
}
